{
  "manifest_version": 3,
  "name": "Leitura Acessível",
  "version": "0.4.0",
  "description": "Fonte OpenDyslexic, espaçamentos, cores e leitura em voz alta em qualquer página. Protótipo para pessoas com dislexia.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],

  "action": {
    "default_title": "Leitura Acessível",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "sidebar_action": {
    "default_title": "Leitura Acessível",
    "default_panel": "popup/popup.html?painel=1",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "open_at_install": false
  },

  "side_panel": {
    "default_path": "popup/popup.html?painel=1"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/estilos.css"],
      "js": ["shared/settings.js", "content/regua.js", "content/content.js", "content/tts.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "leitura-acessivel@exemplo.org",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
